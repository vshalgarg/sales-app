pipeline {
  agent any

  environment {
    IMAGE_NAME = "sales-app-ui"
    CONTAINER_NAME = "sales-app-ui"
    PORT = "8087"
  }

  stages {
    
    stage('Checkout') {
      steps {
        echo "Checking out Sales App UI code..."
        checkout scm
      }
    }

    stage('Install & Build Vite App') {
      steps {
        echo "Installing dependencies and building the Vite project..."
        sh '''
          npm install
          npm run build
        '''
      }
    }

    stage('Build Docker Image') {
      steps {
        echo "Building Docker image for Sales App UI..."
        sh 'docker build -t $IMAGE_NAME .'
      }
    }

    stage('Stop Old Container') {
      steps {
        echo "Stopping previous container if running..."
        sh '''
          docker stop $CONTAINER_NAME || true
          docker rm $CONTAINER_NAME || true
        '''
      }
    }

    stage('Run New Container') {
      steps {
        echo "Running new Nukkad Admin UI container at port $PORT..."
        sh '''
          docker run -d \
            --name $CONTAINER_NAME \
            --restart unless-stopped \
            -p $PORT:$PORT \
            $IMAGE_NAME
        '''
      }
    }
  }

  post {
    success {
     echo "Deployment successful! Sales App UI running on port $PORT"
    }
    failure {
      echo "Deployment failed! Check build logs."
    }
  }
}