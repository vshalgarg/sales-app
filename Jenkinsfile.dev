pipeline {
  agent any

  parameters {
    string(name: 'BRANCH_NAME', defaultValue: 'frontend_sales_dev', description: 'Branch to build')
  }

  environment {
    IMAGE_NAME = "sales-app-ui"
    CONTAINER_NAME = "sales-app-ui"
    PORT = "8088"
    BUILD_MODE = 'development'
  }

  stages {

    stage('Checkout') {
      steps {
        echo "checking out branch from git ${params.BRANCH_NAME}"
        git branch: "${params.BRANCH_NAME}",
                url: 'git@github.com:vshalgarg/sales-app.git'
      }
    }

    stage('Build Docker Image') {
      steps {
        echo "Building Docker image for Sales App UI..."
        sh 'docker build --build-arg BUILD_MODE=$BUILD_MODE -t $IMAGE_NAME .'
      }
    }

    stage('Stop Old Container') {
      steps {
        echo "Stopping previous container if running..."
        sh '''
          docker stop $CONTAINER_NAME || true
          docker rm $CONTAINER_NAME || true
        '''
      }
    }

    stage('Run New Container') {
      steps {
        echo "Running new Sales App UI container at port $PORT..."
        sh '''
          docker run -d \
            --name $CONTAINER_NAME \
            --restart unless-stopped \
            -p $PORT:80 \
            $IMAGE_NAME
        '''
      }
    }
    
  }

  post {
    success {
      echo "Deployment successful! Sales App UI running on port $PORT"
    }
    failure {
      echo "Deployment failed! Check build logs."
    }
  }
}
