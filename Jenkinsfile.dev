pipeline {
  agent any

  parameters {
    string(
      name: 'BRANCH',
      defaultValue: 'frontend_sales_dev',
      description: 'Git branch to build and deploy (e.g. feature/my-branch)',
    )
  }

  environment {
    IMAGE_NAME = "sales-app-ui"
    CONTAINER_NAME = "sales-app-ui"
    PORT = "8088"
  }

  stages {
    
    stage('Checkout') {
      steps {
        script {
          def branch = params.BRANCH?.trim() ?: 'frontend_sales_dev'
          branch = branch.replaceFirst(/^origin\//, '')
          env.DEPLOY_BRANCH = branch
        }
        echo "Checking out Sales App UI branch: ${env.DEPLOY_BRANCH}"
        checkout([
          $class: 'GitSCM',
          branches: [[name: "*/${env.DEPLOY_BRANCH}"]],
          extensions: [],
          userRemoteConfigs: scm.userRemoteConfigs,
        ])
      }
    }

    stage('Install & Build Vite App') {
      steps {
        echo "Installing dependencies and building the Vite project..."
        sh '''
          npm install
          npm run build
        '''
      }
    }

    stage('Build Docker Image') {
      steps {
        echo "Building Docker image for Sales App UI..."
        sh 'docker build -t $IMAGE_NAME .'
      }
    }

    stage('Stop Old Container') {
      steps {
        echo "Stopping previous container if running..."
        sh '''
          docker stop $CONTAINER_NAME || true
          docker rm $CONTAINER_NAME || true
        '''
      }
    }

    stage('Run New Container') {
      steps {
        echo "Running new Nukkad Admin UI container at port $PORT..."
        sh '''
          docker run -d \
            --name $CONTAINER_NAME \
            --restart unless-stopped \
            -p $PORT:80 \
            $IMAGE_NAME
        '''
      }
    }
  }

  post {
    success {
     echo "Deployment successful! Sales App UI (${env.DEPLOY_BRANCH}) running on port $PORT"
    }
    failure {
      echo "Deployment failed! Check build logs."
    }
  }
}
