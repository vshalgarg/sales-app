pipeline {
    agent any

    environment {
        IMAGE_NAME = "vshalgargnpl/sales-api"
        TAG = "latest"
        CONTAINER_NAME = "sales-api"
        PORT_MAPPING = "8087:8087"  // host:container
        REGISTRY = "index.docker.io/v1/"
    }

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'backend_sales_dev', description: 'Branch to build')
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out from git'
                git branch: "${params.BRANCH_NAME}",
                    url: 'git@github.com:vshalgarg/sales-app.git'
            }
        }

      stage('Build JAR') {
          steps {
              echo 'Building using maven'
              sh '''
                  chmod +x mvnw
                  ./mvnw clean package -DskipTests
              '''
          }
      }


     stage('Build Docker Image') {
         steps {
             echo 'Building Docker image for Sales App backend'
             sh '''
                 docker build -t "$IMAGE_NAME:$TAG" .
             '''
         }
     }

     stage('Docker Push') {
         steps {
             script {
                 docker.withRegistry("https://${REGISTRY}", 'docker-credentials-id') {
                     def appImage = docker.build("${IMAGE_NAME}:${TAG}")
                     appImage.push()
                 }
             }
         }
     }

        stage('Stop Existing Container') {
            steps {
                sh '''
                    docker stop "$CONTAINER_NAME" || true
                    docker rm "$CONTAINER_NAME" || true
                '''
            }
        }

        stage('Run New Container') {
            steps {
                withCredentials([
                    string(credentialsId: 'NUKKAD_MYSQL_PASSWORD', variable: 'MYSQL_PASSWORD')
                ]) {
                    sh '''
                        docker run -d --name "$CONTAINER_NAME" \
                          -p "$PORT_MAPPING" \
                          --restart unless-stopped \
                          --add-host=host.docker.internal:host-gateway \
                          -e SPRING_PROFILES_ACTIVE=dev \
                          -e spring.datasource.password="$MYSQL_PASSWORD" \
                          -v /var/log/sales-api:/logs \
                          "$IMAGE_NAME:$TAG"
                    '''
                }
            }
        }

        stage('Clean Up') {
            steps {
                sh 'docker image prune -f'
            }
        }
    }
}